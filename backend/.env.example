# Base de datos
# Desarrollo local (Docker): postgresql+asyncpg://plotskip:plotskip@localhost:5432/plotskip
# Neon (producción): postgresql+asyncpg://user:pass@ep-xxx.neon.tech/plotskip?sslmode=require
DATABASE_URL=postgresql+asyncpg://plotskip:plotskip@localhost:5432/plotskip

# JWT — genera un valor seguro con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia_esto_por_un_valor_seguro

# TMDB — obtener en https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Resend — obtener en https://resend.com/api-keys
RESEND_API_KEY=
