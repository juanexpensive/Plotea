# Base de datos (Neon)
# Copia la connection string desde console.neon.tech y usa el driver asyncpg.
# Ejemplo:
# DATABASE_URL=postgresql+asyncpg://neondb_owner:TU_PASSWORD@ep-xxx.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL=

# JWT - genera un valor seguro con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# TMDB - obtener en https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Resend — obtener en https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Password reset
PASSWORD_RESET_BASE_URL=plotskip://reset-password

# Uploads persistentes (recomendado en Railway: /app/uploads con un Volume montado en esa ruta)
UPLOADS_DIR=
